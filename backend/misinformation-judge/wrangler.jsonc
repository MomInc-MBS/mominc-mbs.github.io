{
  "name": "mom-misinformation-judge",
  "main": "entry.mjs",
  "account_id": "f35c131b47d223ae301a8b577d6e2d59",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "InferenceBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "InferenceBudget"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "PER_IP",
      "namespace_id": "10151001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "AI_MODEL": "@cf/cloudflare/clef-flash",
    "GLOBAL_PER_MINUTE": "60",
    "GLOBAL_PER_DAY": "4000"
  }
}
