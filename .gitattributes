* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.webm binary
*.mp4 binary
*.glb binary
*.gltf.bin binary
*.bin binary
*.mp3 binary
*.ogg binary
*.wav binary
*.woff binary
*.woff2 binary
*.ico binary

# Frozen experiment inputs and supplied handoffs are evidence, including BOM/CRLF.
tools/hive_engine/data/inputs/*.srt -text whitespace=cr-at-eol
hive/updates/*.md -text
hive/implementation/*.md -text
hive/evidence/** -text
# Versioned source export is bound to the publication manifest, including EOLs.
hive/implementation/autonomous-v01/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
hive/implementation/adaptive-v02/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
