{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:capability_manifest:1",
  "title": "capability_manifest",
  "type": "object",
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "tool",
        "model",
        "adapter",
        "head",
        "workflow",
        "supervisor"
      ]
    },
    "input_schema": {
      "type": "string",
      "minLength": 1
    },
    "output_schema": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_lineage": {
      "type": "object",
      "properties": {
        "base_hash": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_hash": {
          "type": "string",
          "minLength": 1
        },
        "adapter_hash": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "measured_peak_ram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "measured_peak_vram_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_run_id": {
          "type": "string",
          "minLength": 1
        },
        "admission_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "admission_policy"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "checker": {
          "type": "string",
          "minLength": 1
        },
        "supported_scope": {
          "type": "string",
          "minLength": 1
        },
        "abstention_condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "checker",
        "supported_scope",
        "abstention_condition"
      ],
      "additionalProperties": false
    },
    "memory_scopes": {
      "type": "object",
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "read",
        "write"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "capability_id",
    "version",
    "kind",
    "input_schema",
    "output_schema",
    "executor",
    "artifact_hashes",
    "resources",
    "verification",
    "memory_scopes"
  ],
  "additionalProperties": false
}
