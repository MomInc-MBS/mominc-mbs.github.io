  "labels": {
    "routing": "Rules for selecting eligible routes and deciding which worker or tool acts.",
    "evidence": "Requirements for outputs, traces, recorded identities, or verifiable receipts.",
    "recovery": "Requirements for restart, rollback, stopping, resuming, and avoiding duplicate side effects.",
    "limits": "Limits on resources, execution authority, modifications, or production promotion."
  },
  "items": [
    {
      "id": "d1",
      "text": "Use honest initial priors, deterministic fallbacks, and transparent logs."
    },
    {
      "id": "d2",
      "text": "One real local-model specialist task completes with model identity and trace."
    },
    {
      "id": "d3",
      "text": "Fresh-process reload restores the correct state; rollback restores a prior policy."
    },
    {
      "id": "d4",
      "text": "No unbounded self-modification, hidden resource consumption, silent budget reset, unrestricted shell execution, or automatic promotion to production."
    },
    {
      "id": "d5",
      "text": "No utility score can override a hard eligibility failure."
    },
    {
      "id": "d6",
      "text": "Every decision and failure has versioned, inspectable receipts."
    },
    {
      "id": "d7",
      "text": "STOP/resume and one injected failure do not duplicate unauthorized side effects."
    },
    {
      "id": "d8",
      "text": "Save actual outputs and a structured evidence trail."
    }
  ],
